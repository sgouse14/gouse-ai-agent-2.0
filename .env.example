GEMINI_API_KEY=
GOAI_MODEL=
OPENAI_API_KEY=

# Internal Gousiya emergency-recovery configuration. Keep audit and grant files
# in separate, persistent, access-restricted paths on the same host.
FIREBASE_PROJECT_ID=
# Firebase Web API key used for account-status lookup. Restrict to Identity Toolkit
# in Google Cloud; it does not replace trusted server-side approval issuance.
FIREBASE_WEB_API_KEY=
# Generate a fresh 32-byte random key encoded as hex (openssl rand -hex 32).
# Never commit the generated secret. It signs internal approval attestations.
GOUSIYA_APPROVAL_SIGNING_SECRET=
# Owner-only JSON registry of approved approver UIDs/roles; chmod 600.
# Its parent directory must also be owner-only (chmod 700).
GOUSIYA_APPROVER_REGISTRY_PATH=
GOUSIYA_AUDIT_FILE_PATH=
GOUSIYA_GRANT_STORE_FILE_PATH=
