GEMINI_API_KEY=
GOAI_MODEL=
OPENAI_API_KEY=

# Internal Gousiya emergency-recovery configuration. Keep audit and grant files
# in separate, persistent, access-restricted paths on the same host.
FIREBASE_PROJECT_ID=
# Firebase Web API key used for account-status lookup. Restrict to Identity Toolkit
# in Google Cloud; it does not replace trusted server-side approval issuance.
FIREBASE_WEB_API_KEY=
# Generate a fresh 32-byte random key encoded as hex (openssl rand -hex 32).
# Never commit the generated secret. It signs internal approval attestations.
GOUSIYA_APPROVAL_SIGNING_SECRET=
# Owner-only JSON registry of approved approver UIDs/roles; chmod 600.
# Its parent directory must also be owner-only (chmod 700).
GOUSIYA_APPROVER_REGISTRY_PATH=
GOUSIYA_AUDIT_FILE_PATH=
GOUSIYA_GRANT_STORE_FILE_PATH=

# Optional Saqlain audit backend. Defaults to file for local development; use firestore for Cloud Run staging.
SAQLAIN_AUDIT_BACKEND=file

# Optional Firestore backend for Saqlain staging. Use Cloud Run's attached service account (no key files).
# Grant only roles/datastore.user to the runtime service account in the target staging project.
GOOGLE_CLOUD_PROJECT=
SAQLAIN_FIRESTORE_AUDIT_COLLECTION=saqlainAuditEvents
SAQLAIN_FIRESTORE_HEARTBEAT_COLLECTION=saqlainAgentHeartbeats
SAQLAIN_FIRESTORE_QUEUE_COLLECTION=saqlainTasks

# Saqlain's workspace-level security-summary endpoint fails closed if unset or unwritable.
# Uses the durable hash-chained audit log; it may share a path with another trusted server-side audit writer.
SAQLAIN_AUDIT_FILE=

# Optional authorized website diagnostics allowlist, keyed by server-approved project ID.
# Exact hostnames only; no wildcards, schemes, ports, or unapproved destinations.
# Example: {"proj-01":["example.com","www.example.com"]}
# POST /api/website/diagnostics requires Firebase auth, project membership, host allowlisting, and durable audit.
SAQLAIN_WEBSITE_ALLOWED_HOSTS_JSON=

# Frontend Firebase Authentication (must target the same Firebase project as the server).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Server-reviewed mapping from Firebase UID to permitted project IDs.
# Example shape: {"firebase-uid-123":["proj-01","proj-02"]}
# Project-scoped APIs fail closed until approved UID/project entries are provisioned.
SAQLAIN_PROJECT_MEMBERSHIPS_JSON=

# Consolidated Firestore-backed agent registry and Gousiya workflow APIs.
# Keep both APIs disabled until staging IAM, owner UID allowlists, and recovery tests are reviewed.
SAQLAIN_AGENT_REGISTRY_ENABLED=false
# JSON array of explicitly approved Firebase UIDs, e.g. ["trusted-firebase-uid-1"].
SAQLAIN_AGENT_REGISTRY_OWNER_UIDS_JSON=[]
# Optional collection overrides; each registry/ledger/audit collection must be distinct.
SAQLAIN_AGENT_REGISTRY_COLLECTION=saqlainAgents
SAQLAIN_AGENT_ISSUED_IDS_COLLECTION=saqlainAgentIssuedIds
SAQLAIN_AGENT_AUDIT_COLLECTION=saqlainAgentAudit

GOUSIYA_WORKFLOW_API_ENABLED=false
# JSON array of explicitly approved Firebase UIDs, e.g. ["trusted-firebase-uid-1"].
GOUSIYA_WORKFLOW_OWNER_UIDS_JSON=[]
# Optional collection overrides; workflow/event/approval collections must be distinct.
GOUSIYA_WORKFLOW_COLLECTION=gousiyaRecoveryWorkflows
GOUSIYA_WORKFLOW_EVENT_COLLECTION=gousiyaRecoveryEvents
GOUSIYA_APPROVAL_CONSUMPTION_COLLECTION=gousiyaApprovalConsumption

# Optional trusted proxy hop count. Keep unset unless the app is reachable only
# through this exact, reviewed reverse-proxy chain.
TRUST_PROXY_HOPS=


# Optional remote Saqlain backup archive. In Cloud Run, a bucket is mandatory because
# container filesystems are ephemeral; the service fails closed at startup without it.
# Use an owner-managed bucket with object versioning enabled and least-privilege GCS IAM.
# The attached Cloud Run service identity is used; never place service-account keys here.
SAQLAIN_BACKUP_GCS_BUCKET=
SAQLAIN_BACKUP_GCS_PREFIX=saqlain-backups
# Set true in non-Cloud-Run deployments that also require the off-site archive.
SAQLAIN_BACKUP_OFFSITE_REQUIRED=false
# Independent local process checking the verified monitoring cycle in the hash-chained audit log.
# The systemd timer runs every 5 minutes; health checks fail if the latest monitored cycle is stale/non-healthy.
SAQLAIN_OPS_HEALTH_MAX_AGE_MINUTES=45

# Optional off-host monitoring alert receiver. Leave all values blank to use local journal only.
# HTTPS URL must use a host in the exact hostname allowlist; no custom ports/query/fragment.
# Use a high-entropy bearer token shared with the receiver through a secret manager.
SAQLAIN_MONITORING_ALERT_WEBHOOK_URL=
SAQLAIN_MONITORING_ALERT_WEBHOOK_TOKEN=
# JSON array of exact DNS hostnames, e.g. ["alerts.example.com"]; wildcards/IPs are rejected.
SAQLAIN_MONITORING_ALERT_WEBHOOK_ALLOWED_HOSTS_JSON=
# Optional request timeout, 250–15000 milliseconds; defaults to 5000.
SAQLAIN_MONITORING_ALERT_WEBHOOK_TIMEOUT_MS=5000

# Optional trusted EMP telemetry integration for the Saqlain monitoring runtime.
# Enable only after an owner-managed server-side collector writes a protected JSON snapshot file.
# The snapshot must be owned by the runtime account; its parent directory must not be group/world writable.
# File format: sourceId, observedAt (ISO 8601), sourceHealth, explicitEmpAlarm,
# powerQualityAlarmCount, unexpectedRestartCount, networkInterfaceFlapCount,
# clockDriftMs, telemetryGapCount. The source must never be trusted merely because it is supplied by a client.
SAQLAIN_EMP_TELEMETRY_ENABLED=false
SAQLAIN_EMP_TELEMETRY_FILE=
# JSON array of exact owner-approved telemetry source IDs, e.g. ["facility-power-monitor-1"].
SAQLAIN_EMP_TELEMETRY_ALLOWED_SOURCE_IDS_JSON=
