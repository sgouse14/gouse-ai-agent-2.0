GEMINI_API_KEY=
GOAI_MODEL=
OPENAI_API_KEY=

# Internal Gousiya emergency-recovery configuration. Keep audit and grant files
# in separate, persistent, access-restricted paths on the same host.
FIREBASE_PROJECT_ID=
# Firebase Web API key used for account-status lookup. Restrict to Identity Toolkit
# in Google Cloud; it does not replace trusted server-side approval issuance.
FIREBASE_WEB_API_KEY=
# Generate a fresh 32-byte random key encoded as hex (openssl rand -hex 32).
# Never commit the generated secret. It signs internal approval attestations.
GOUSIYA_APPROVAL_SIGNING_SECRET=
# Owner-only JSON registry of approved approver UIDs/roles; chmod 600.
# Its parent directory must also be owner-only (chmod 700).
GOUSIYA_APPROVER_REGISTRY_PATH=
GOUSIYA_AUDIT_FILE_PATH=
GOUSIYA_GRANT_STORE_FILE_PATH=

# Optional Saqlain audit backend. Defaults to file for local development; use firestore for Cloud Run staging.
SAQLAIN_AUDIT_BACKEND=file

# Optional Firestore backend for Saqlain staging. Use Cloud Run's attached service account (no key files).
# Grant only roles/datastore.user to the runtime service account in the target staging project.
GOOGLE_CLOUD_PROJECT=
SAQLAIN_FIRESTORE_AUDIT_COLLECTION=saqlainAuditEvents
SAQLAIN_FIRESTORE_HEARTBEAT_COLLECTION=saqlainAgentHeartbeats
SAQLAIN_FIRESTORE_QUEUE_COLLECTION=saqlainTasks

# Saqlain's workspace-level security-summary endpoint fails closed if unset or unwritable.
# Uses the durable hash-chained audit log; it may share a path with another trusted server-side audit writer.
SAQLAIN_AUDIT_FILE=

# Optional authorized website diagnostics allowlist, keyed by server-approved project ID.
# Exact hostnames only; no wildcards, schemes, ports, or unapproved destinations.
# Example: {"proj-01":["example.com","www.example.com"]}
# POST /api/website/diagnostics requires Firebase auth, project membership, host allowlisting, and durable audit.
SAQLAIN_WEBSITE_ALLOWED_HOSTS_JSON=

# Frontend Firebase Authentication (must target the same Firebase project as the server).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Server-reviewed mapping from Firebase UID to permitted project IDs.
# Example shape: {"firebase-uid-123":["proj-01","proj-02"]}
# Project-scoped APIs fail closed until approved UID/project entries are provisioned.
SAQLAIN_PROJECT_MEMBERSHIPS_JSON=

# Optional trusted proxy hop count. Keep unset unless the app is reachable only
# through this exact, reviewed reverse-proxy chain.
TRUST_PROXY_HOPS=

