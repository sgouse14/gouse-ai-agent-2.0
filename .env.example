GEMINI_API_KEY=
GOAI_MODEL=
OPENAI_API_KEY=

# Internal Gousiya emergency-recovery configuration. Use a persistent, restricted
# host directory for both paths, and keep audit and grant state in separate files.
# Runtime construction also requires a code-supplied verifyFirebaseTokenIsActive
# callback wired to Firebase Admin verifyIdToken(token, true), or equivalent.
# The callback is mandatory; environment variables alone are not production setup.
FIREBASE_PROJECT_ID=
GOUSIYA_AUDIT_FILE_PATH=
GOUSIYA_GRANT_STORE_FILE_PATH=
