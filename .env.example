GEMINI_API_KEY=
GOAI_MODEL=
OPENAI_API_KEY=

# Internal Gousiya emergency-recovery configuration. Use a persistent, restricted
# host directory for both paths, and keep audit and grant state in separate files.
# Runtime construction also requires a real Firebase Admin Auth instance,
# wired through createFirebaseAdminTokenActivityChecker(), which calls
# verifyIdToken(token, true). The firebase-admin dependency and trusted credentials
# are not yet wired into the app; environment variables alone are not production setup.
FIREBASE_PROJECT_ID=
GOUSIYA_AUDIT_FILE_PATH=
GOUSIYA_GRANT_STORE_FILE_PATH=
